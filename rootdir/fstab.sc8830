# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
# <src>                                         <mnt_point>  <type>  <mnt_flags and options>             <fs_mgr_flags>

/dev/block/platform/sprd-sdhci.3/by-name/SYSTEM	/system      ext4 ro,errors=panic                                    	                        	wait
/dev/block/platform/sprd-sdhci.3/by-name/userdata /data        f2fs nosuid,nodev,noatime,nodiscard,inline_xattr,inline_data,background_gc=on,gc_merge,flush_merge wait,check,formattable,quota,reservedsize=128M,fsync_mode=nobarrier
/dev/block/platform/sprd-sdhci.3/by-name/userdata /data        ext4 nosuid,nodev,noatime,barrier=1,errors=continue wait,check,formattable,quota,reservedsize=128M
/dev/block/platform/sprd-sdhci.3/by-name/CSC      /cache       f2fs nosuid,nodev,noatime,nodiscard,inline_xattr,inline_data,background_gc=on wait,check,formattable
/dev/block/platform/sprd-sdhci.3/by-name/CSC      /cache       ext4 nosuid,nodev,noatime,barrier=1,errors=panic wait,check,formattable
/dev/block/platform/sprd-sdhci.3/by-name/efs	  /efs         ext4 nosuid,nodev,noatime,barrier=1,errors=panic wait,check
/dev/block/platform/sprd-sdhci.3/by-name/prodnv   /productinfo ext4 nosuid,nodev,noatime,barrier=1,errors=panic wait,check

# Boot partitions
/dev/block/platform/sprd-sdhci.3/by-name/KERNEL   /boot	       emmc defaults										recoveryonly
/dev/block/platform/sprd-sdhci.3/by-name/HIDDEN   /preload     ext4 defaults										recoveryonly
/dev/block/platform/sprd-sdhci.3/by-name/RECOVERY /recovery    emmc defaults										recoveryonly

# VOLD
/devices/sprd-sdhci.0/mmc_host/mmc1*		  auto         auto defaults										voldmanaged=sdcard1:auto,encryptable=userdata
/devices/f5116000.usb/usb*			  auto         auto defaults										voldmanaged=usb:auto
/dev/block/zram0							  auto	       swap defaults										notrim
